DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/smart_eval
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

MISTRAL_API_KEY=mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest

SERPER_API_KEY=your-serper-api-key-here

# Zoom Server-to-Server OAuth app (Marketplace > Develop > Build App > Server-to-Server OAuth).
# Free plan: meeting creation + event webhooks work. Participant Report API needs a paid plan.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# From the app's Feature > Event Subscriptions "Secret Token". Used to verify webhook signatures.
# Webhook endpoint to register in Zoom: POST {API_URL}/api/v1/meetings/zoom/webhook
ZOOM_WEBHOOK_SECRET_TOKEN=
